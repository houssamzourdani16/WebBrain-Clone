# =============================================================================
# Clone WebBrain — Vercel API environment variables (placeholders only)
# Copy this file to .env for local tooling:  copy .env.example .env
# NEVER commit .env. NEVER place these values inside the Chrome extension.
# =============================================================================

# MongoDB Atlas connection string (database: clone_webbrain_tasks, collection: tasks)
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clone_webbrain_tasks?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/clone_webbrain_tasks?retryWrites=true&w=majority

# Key the extension (and the AI agent) sends as the X-API-Key header.
# Only grants: GET tasks list/detail + PATCH status to "done".
EXTENSION_API_KEY=replace-with-a-long-random-string

# Key the admin CRUD page sends as the X-Admin-Key header.
# Grants: create, edit, delete. Keep it separate from EXTENSION_API_KEY.
ADMIN_API_KEY=replace-with-a-different-long-random-string
