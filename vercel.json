{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/tasks", "destination": "/api/server?path=tasks" },
    { "source": "/api/tasks/:day", "destination": "/api/server?path=tasks/:day" },
    { "source": "/api/health", "destination": "/api/server?path=health" }
  ],
  "headers": [
    {
      "source": "/manage.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
